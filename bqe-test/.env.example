# BQE API testing harness — credentials for the "Jot Testing" OAuth app
# registered separately on the BQE Developer Portal. Keep production
# credentials out of this file.
#
# Copy this file to `.env` (which is gitignored) and fill in the values.
BQE_TEST_CLIENT_ID=
BQE_TEST_CLIENT_SECRET=

# BQE Core API base. Confirm with your tenant's API documentation — this is
# the v2 endpoint typical for non-EU tenants. EU/AP tenants use a different
# regional host (e.g. coreapi1-02 / coreapi1-eu).
BQE_API_BASE=https://coreapi1-01.bqecore.com/coreapi/v2

# OAuth endpoints. These are the real BQE Core OIDC endpoints — confirmed
# working from the Jot iOS production app (see services/bqe/auth.ts). The
# older `api-login.bqe.com` host shown in some BQE docs does NOT resolve;
# Safari surfaces it as "couldn't establish a secure connection."
BQE_AUTHORIZE_URL=https://api-identity.bqecore.com/idp/connect/authorize
BQE_TOKEN_URL=https://api-identity.bqecore.com/idp/connect/token

# Redirect URI. Must match exactly what's registered for the "Jot Testing"
# app in the Developer Portal. The local callback server in auth.mjs binds
# to this host/port and waits for the OAuth redirect.
BQE_REDIRECT_URI=http://localhost:8765/callback
