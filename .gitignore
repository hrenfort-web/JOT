# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# bqe-test harness — cached OAuth tokens. .env and node_modules are
# already covered by the broader patterns above. Unanchored so it matches
# bqe-test/.token.json wherever it lands.
.token.json

# Claude Code session state
.claude/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
